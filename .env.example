# ============ DATABASE ============
# Supabase: use the "Transaction" pooler (port 6543) for runtime queries
# on Vercel. Find it under Project → Settings → Database → Connection string
# → "Transaction" mode. The `pgbouncer=true&connection_limit=1` query params
# are required for Prisma on serverless.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection on port 5432, used only by `prisma db push`
# / `prisma migrate`. Find it under Project → Settings → Database →
# Connection string → "Session" mode (or the original direct URL).
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ============ AUTH ============
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-char-string"
APP_BASE_URL="http://localhost:3000"

# ============ XENDIT ============
XENDIT_SECRET_KEY="xnd_development_..."
XENDIT_WEBHOOK_VERIFICATION_TOKEN=""
XENDIT_CALLBACK_URL="http://localhost:3000/api/webhooks/xendit"

# ============ WHATSAPP (Wati or Twilio) ============
WATI_API_KEY=""
WATI_TENANT_ID=""
WATI_API_URL=""

# ============ EMAIL (Resend) ============
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="booking@example.com"

# ============ GOOGLE OAUTH (customer sign-in) ============
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_BASE_URL}/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# ============ QR SIGNING ============
# Generate with: openssl rand -hex 32
QR_HMAC_SECRET="change-me-to-a-32-byte-hex-secret"

# ============ STORAGE (Supabase) ============
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# ============ MONITORING ============
SENTRY_DSN=""
POSTHOG_API_KEY=""

# ============ BUSINESS RULES ============
PLATFORM_COMMISSION_RATE="0.08"
BOOKING_HOLD_MINUTES="30"

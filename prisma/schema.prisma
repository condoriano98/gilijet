  AIR_CONDITIONING
  TOILET
  WIFI
  LIFE_JACKET
  LIFE_RAFT
  ENTERTAINMENT_SYSTEM
  SNACK_SERVICE
  DRINK_SERVICE
  CHARGING_PORT
  BLANKET
  FIRST_AID_KIT
  BAGGAGE_COMPARTMENT
  OUTDOOR_DECK
  CABIN_SEATING
  SMOKING_AREA
  PRAYER_ROOM
}

enum OperatorService {
  BAGGAGE_INSURANCE
  TRAVEL_INSURANCE
  HOTEL_TRANSFER
  MEAL_INCLUDED
  PRIORITY_BOARDING
  FLEXIBLE_RESCHEDULE
  CHILD_DISCOUNT
  GROUP_BOOKING
  PET_FRIENDLY
  WHEELCHAIR_ACCESSIBLE
}

enum FareRefundability {
  REFUNDABLE
  NON_REFUNDABLE
  PARTIALLY_REFUNDABLE
}

enum ScheduleType {
  DIRECT
  TRANSIT
}

enum FareType {
  REFUNDABLE
  NON_REFUNDABLE
}

// ============== PHASE 2 ENUMS ==============


# Reverse proxy in front of the Next.js app.
#
# With APP_DOMAIN set, Caddy obtains and renews a Let's Encrypt certificate for
# it automatically and serves HTTPS on :443, redirecting :80 — so DOKU payment
# notifications and card-holder traffic are not carried in the clear.
#
# With APP_DOMAIN empty the site address falls back to :80, so the box keeps
# serving plain HTTP on a bare IP exactly as before and Caddy never attempts a
# certificate it could not get anyway.
{$APP_DOMAIN::80} {
	reverse_proxy app:3000

	encode gzip

	# Notification senders get no benefit from these and some
	# scanners flag their absence, so set them once here rather than per-route.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

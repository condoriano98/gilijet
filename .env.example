# ============ DATABASE ============
# Supabase: use the "Transaction" pooler (port 6543) for runtime queries
# on Vercel. Find it under Project → Settings → Database → Connection string
# → "Transaction" mode. The `pgbouncer=true&connection_limit=1` query params
# are required for Prisma on serverless.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection on port 5432, used only by `prisma migrate`
# (the Prisma CLI). Find it under Project → Settings → Database →
# Connection string → "Session" mode (or the original direct URL).
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ============ AUTH ============
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-char-string"
APP_BASE_URL="http://localhost:3000"

# Production (droplet) only. Set to a domain whose A record points at the box
# and Caddy issues + renews a Let's Encrypt certificate for it automatically;
# deploy.sh then rewrites APP_BASE_URL to https://<domain>. Left blank the box
# serves plain HTTP, which DOKU accepts but which carries payment notifications
# in the clear. Ignored outside Docker.
APP_DOMAIN=""

# ============ XENDIT ============
XENDIT_SECRET_KEY="xnd_development_..."
XENDIT_WEBHOOK_VERIFICATION_TOKEN=""
XENDIT_CALLBACK_URL="http://localhost:3000/api/webhooks/xendit"

# ============ DOKU CHECKOUT — the payment gateway ============
# Get these from the DOKU Back Office (Integration → API keys).
# Register the notification URL there as: {APP_BASE_URL}/api/webhooks/doku
# DOKU signs the request path, so that URL must match exactly.
# Leave blank to keep the app in mock mode — checkout falls back to the
# built-in dummy flow and no real money moves.
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""
DOKU_IS_PRODUCTION="false"

# ============ PAYPAL — backup gateway for cards DOKU declines ============
# developer.paypal.com/dashboard -> Apps & Credentials (Sandbox/Live toggle).
# PAYPAL_WEBHOOK_ID comes from the webhook you register at
#   {APP_BASE_URL}/api/webhooks/paypal  (subscribe to PAYMENT.CAPTURE.*).
# Sandbox and live have separate apps and separate webhook ids.
#
# PayPal cannot settle IDR, so bookings are charged in the presentment currency
# at the stored FX rate. If refresh-fx has not run in 72h PayPal is not offered
# at all — it refuses rather than charging a guessed rate.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_IS_PRODUCTION="false"
PAYPAL_PRESENTMENT_CURRENCY="USD"

# ============ WHATSAPP (Meta Cloud API) ============
# Carries the payment-received notice, the boarding pass, staff alerts and the
# PIC order message. Leave the token or phone number id blank and
# features/messaging/whatsapp.ts logs the message to the console instead.
# Use a permanent system-user token (a temporary one expires after ~24 hours).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v26.0"
WHATSAPP_TEMPLATE_LANG="id"

# Fallback destination + approved template for staff booking alerts. The
# /admin/console/alerts setting overrides these when set, so the on-call number
# can change without a redeploy. Both must be present or alerts stay off.
# The template takes nine positional variables: event, reference, route,
# departure, boat, customer, pax, amount, action.
ADMIN_WHATSAPP_NUMBER=""
ADMIN_ALERT_TEMPLATE=""

# Approved template sent to the operator's PICs (OperatorPicContact
# nohpNotifikasi) when a booking is paid. Nine positional variables: booking
# code, boat, route, date and time, customer name, email, phone, passenger
# count, passenger list. Blank = skipped.
WHATSAPP_TEMPLATE_ORDER_NOTIF=""

# ============ EMAIL (Gmail SMTP) ============
# Outbound mail. Use a Gmail app password (myaccount.google.com/apppasswords,
# needs 2-Step Verification), never the account password. Any of host / user /
# password / from blank = console-only mock.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="admin@example.com"
SMTP_PASSWORD=""
EMAIL_FROM="Gilifast <admin@example.com>"

# ============ OPERATOR E-TICKET INBOX (IMAP) ============
# Read by /api/cron/poll-operator-inbox (CRON_SECRET), read-only. Same kind of
# app password. Blank = the poller does nothing.
INBOX_IMAP_HOST="imap.gmail.com"
INBOX_IMAP_PORT="993"
INBOX_IMAP_USER="admin@example.com"
INBOX_IMAP_PASSWORD=""
# Only look at mail that arrived on or after this date (YYYY-MM-DD, WITA); blank = last 7 days.
INBOX_POLL_SINCE=""
# Must be exactly "true" to forward tickets to buyers; otherwise the poll only
# reports what it would do (dry run).
INBOX_POLL_LIVE="false"

# ============ GOOGLE OAUTH (customer sign-in) ============
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_BASE_URL}/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# ============ QR SIGNING ============
# Generate with: openssl rand -hex 32
QR_HMAC_SECRET="change-me-to-a-32-byte-hex-secret"

# ============ STORAGE (Supabase) ============
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# ============ REVIEW MCP (read-only, /api/mcp) ============
# Bearer token for a reviewer who may read but never write. Leave empty and the
# endpoint returns 503 — it never serves unauthenticated. Revoke access by
# rotating this value and redeploying; no database change is involved.
# Generate with: openssl rand -hex 32
MCP_REVIEWER_TOKEN=""
# Set to 1 to mask customer name/email/phone in MCP output (demos, screen shares).
MCP_REDACT_PII=""

# ============ MONITORING ============
SENTRY_DSN=""
POSTHOG_API_KEY=""

# ============ BUSINESS RULES ============
PLATFORM_COMMISSION_RATE="0.08"
BOOKING_HOLD_MINUTES="30"

{
  "name": "gilifast",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db-push-if-configured.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:small": "tsx prisma/seed-small-boats.ts",
    "seed:qa": "tsx scripts/seed-qa.ts",
    "seed:schedules": "tsx scripts/seed-schedules-from-csv.ts",
    "link:ports": "tsx scripts/link-schedules-to-ports.ts",
    "gen:wahana": "tsx scripts/generate-wahana-schedule.ts",
    "import:wahana": "tsx scripts/import-wahana-schedule.ts",
    "purge:dummy": "tsx scripts/purge-dummy-data.ts",
    "docs:db": "python3 scripts/schema-docs.py",
    "midtrans:selftest": "tsx scripts/midtrans-selftest.ts",
    "paypal:selftest": "tsx scripts/paypal-selftest.ts",
    "qc": "pnpm lint && pnpm typecheck",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "deploy": "bash scripts/deploy.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.4",
    "@react-pdf/renderer": "^4.6.1",
    "@supabase/supabase-js": "^2.110.8",
    "@zxing/browser": "0.1.5",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "3.2.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "16.3.2",
    "next-intl": "^4.13.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.54.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.2",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}

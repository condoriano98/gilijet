// ============== PASSWORD RESET ==============

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// ============== PHASE 1B — FACILITIES, TRANSIT ==============

model BoatFacilitiesOnBoat {
  boatId   String
  facility BoatFacility

  boat Boat @relation(fields: [boatId], references: [id], onDelete: Restrict)

  @@id([boatId, facility])
}

model OperatorServicesOnOperator {
  operatorId String
  service    OperatorService

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  @@id([operatorId, service])
}

model TransitStop {
  id             String  @id @default(cuid())
  scheduleId     String
  portName       String
  arrivalTime    String  // "HH:MM"
  departureTime  String  // "HH:MM"
  orderIndex     Int

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([scheduleId, orderIndex])
}

// ============== PHASE 2 — PORT, STAFF, HOLDS, NOTIFICATIONS, KYC ==============

model Port {
  id         String    @id @default(cuid())
  shortCode  String    @unique @db.VarChar(3)
  slug       String    @unique
  name       String
  island     String?
  province   String?
  latitude   Decimal?  @db.Decimal(9, 6)
  longitude  Decimal?  @db.Decimal(9, 6)
  timezone   String    @default("Asia/Makassar")
  isActive   Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  originSchedules      Schedule[] @relation("OriginPort")
  destinationSchedules Schedule[] @relation("DestinationPort")

  @@index([shortCode])
  @@index([isActive])
}

model OperatorStaff {
  id           String             @id @default(cuid())
  operatorId   String
  email        String             @unique
  passwordHash String
  fullName     String
  role         OperatorStaffRole  @default(GATE)
  status       OperatorStaffStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  checkIns Ticket[] @relation("CheckedInBy")
  salesBookings Booking[] @relation("SalesStaff")
  cashDrawerSessions CashDrawerSession[]

  @@index([operatorId, status])
}

model SeatHold {
  id          String         @id @default(cuid())
  legId       String
  sessionKey  String         // anonymous session id OR customer id
  seats       Int
  status      SeatHoldStatus @default(ACTIVE)
  expiresAt   DateTime
  bookingId   String?        @unique  // set when promoted to a real booking
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  leg     Leg     @relation(fields: [legId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([legId, status, expiresAt])
  @@index([sessionKey])
}

model NotificationLog {
  id              String              @id @default(cuid())
  channel         NotificationChannel
  type            NotificationType
  recipient       String              // email / phone
  referenceType   String              // 'booking' | 'refund' | 'reschedule'
  referenceId     String
  status          NotificationStatus  @default(PENDING)
  providerRef     String?
  payloadSummary  Json?               // do not store full PII; just enough to debug
  sentAt          DateTime?
  failedReason    String?
  attempts        Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([referenceType, referenceId])
  @@index([status, createdAt])
}

model OperatorDocument {
  id           String                 @id @default(cuid())
  operatorId   String
  type         OperatorDocumentType
  fileUrl      String
  fileName     String?
  status       OperatorDocumentStatus @default(PENDING)
  verifiedBy   String?                // Admin.id
  verifiedAt   DateTime?
  rejectionNote String?
  expiresAt    DateTime?              // for licences with renewal dates
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  @@unique([operatorId, type])
  @@index([status])
  @@index([expiresAt])
}

// ============== PHASE 3 — AGENTS, LOYALTY, FLEET, ADDONS, WEATHER ==============

model Agent {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  companyName     String
  contactPerson   String
  phoneNumber     String
  tier            AgentTier @default(BRONZE)
  commissionRate  Decimal   @default(0.05) @db.Decimal(5, 4)
  isActive        Boolean   @default(true)
  totalBookings   Int       @default(0)
  totalRevenue    Decimal   @default(0) @db.Decimal(14, 2)
  apiKey          String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  operators Operator[]
  bookings  Booking[]

  @@index([email])
  @@index([isActive])
}

model LoyaltyAccount {
  id              String   @id @default(cuid())
  customerId      String   @unique
  pointsBalance   Int      @default(0)
  lifetimePoints  Int      @default(0)
  tier            AgentTier @default(BRONZE)
  tierExpiresAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer      Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions  LoyaltyTransaction[]

  @@index([customerId])
}

model LoyaltyTransaction {
  id              String                @id @default(cuid())
  accountId       String
  bookingId       String?
  type            LoyaltyTransactionType
  points          Int
  description     String?
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  booking Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([bookingId])
}

model BoatPosition {
  id          String    @id @default(cuid())
  boatId      String
  latitude    Decimal   @db.Decimal(9, 6)
  longitude   Decimal   @db.Decimal(9, 6)
  speedKnots  Decimal?  @db.Decimal(5, 1)
  heading     Int?
  recordedAt  DateTime  @default(now())

  boat Boat @relation(fields: [boatId], references: [id], onDelete: Restrict)

  @@index([boatId, recordedAt])
}

model BookingAddon {
  id          String           @id @default(cuid())
  bookingId   String
  type        BookingAddonType
  name        String
  quantity    Int              @default(1)
  unitPrice   Decimal          @db.Decimal(12, 2)
  totalPrice  Decimal          @db.Decimal(12, 2)
  createdAt   DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
}

model WeatherSnapshot {
  id              String           @id @default(cuid())
  legId           String
  condition       WeatherCondition
  waveHeight      Decimal?         @db.Decimal(4, 2) // metres
  windSpeedKnots  Decimal?         @db.Decimal(5, 1)
  temperature     Decimal?         @db.Decimal(4, 1) // celsius
  source          String           @default("BMKG")
  recordedAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())

  leg Leg @relation(fields: [legId], references: [id], onDelete: Restrict)

  @@index([legId])
  @@unique([legId, recordedAt])
}

// ============== FX RATES ==============

model FxRate {
  id         String   @id @default(cuid())
  currency   String   @db.VarChar(3)
  rate       Decimal  @db.Decimal(12, 6)
  fetchedAt  DateTime @default(now())

  @@index([currency, fetchedAt])
}

// ============== WEATHER FORECAST ==============

model WeatherForecast {
  id           String   @id @default(cuid())
  portName     String
  forecastFor  DateTime
  waveHeightM  Decimal? @db.Decimal(4, 2)
  windKnots    Decimal? @db.Decimal(5, 1)
  condition    WeatherCondition @default(CALM)
  fetchedAt    DateTime @default(now())

  @@index([portName, forecastFor])
}

// ============== ERP — SALES CHANNELS & AGENTS ==============

enum SalesChannel {
  GILIFAST
  // Pre-rename value for the same thing: our own platform. Existing Booking
  // rows still carry it, and dropping an enum value those rows reference is
  // destructive — `prisma db push` would refuse the whole push. Kept for the
  // same reason as the legacy PaymentProvider values above. Anything asking
  // "was this sold on our platform?" must match both; see DIRECT_SALES_CHANNELS
  // in lib/operator-erp-queries.ts.
  GILIJET
  WALK_IN
  TRAVEL_AGENT
  PHONE
  EXTERNAL_AGGREGATOR
}

enum EFakturStatus {
  NOT_REQUIRED
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
}

model TravelAgent {
  id                       String   @id @default(cuid())
  operatorId               String
  operator                 Operator @relation(fields: [operatorId], references: [id])
  name                     String
  contactPerson            String?
  phoneNumber              String?
  email                    String?
  npwp                     String?
  address                  String?
  defaultCommissionPercent Decimal  @db.Decimal(5, 4)
  bankName                 String?
  bankAccountNumber        String?
  bankAccountName          String?
  isActive                 Boolean  @default(true)
  deletedAt                DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  bookings                 Booking[]

  @@index([operatorId, isActive, deletedAt])
}

// ============== ERP — CASH DRAWER ==============

model CashDrawerSession {
  id                  String   @id @default(cuid())
  operatorId          String
  operator            Operator @relation(fields: [operatorId], references: [id])
  staffId             String
  staff               OperatorStaff @relation(fields: [staffId], references: [id])
  openedAt            DateTime
  closedAt            DateTime?
  openingBalance      Decimal  @db.Decimal(14, 2)
  expectedCash        Decimal  @db.Decimal(14, 2) @default(0)
  closingBalanceCounted Decimal? @db.Decimal(14, 2)
  variance            Decimal? @db.Decimal(14, 2)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([operatorId, openedAt])
  @@index([staffId, closedAt])
}

// ============== ERP — OPERATOR NOTIFICATIONS ==============

enum NotificationKind {
  CERT_EXPIRY
  CASH_VARIANCE
  SYNC_FAILURE
  PAYROLL_DRAFT_READY
  SPT_DRAFT_READY
  AGENT_PAYOUT_DUE
  PERIOD_CLOSE_PROMPT
  CORETAX_REJECTION
  BPJS_REJECTION
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model OperatorNotification {
  id           String   @id @default(cuid())
  operatorId   String
  operator     Operator @relation(fields: [operatorId], references: [id])
  kind         NotificationKind
  severity     NotificationSeverity @default(INFO)
  title        String
  body         String
  actionUrl    String?
  data         Json?
  readAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([operatorId, readAt, createdAt])
}

// ============== AUDIT LOG ==============

model AuditLog {
  id            String          @id @default(cuid())
  entityType    AuditEntityType
  entityId      String
  action        String
  userId        String?
  userRole      AuditUserRole?
  previousState Json?
  newState      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Per-email login-failure tracking. A short window of recent rows is consulted
// by lib/login-throttle.ts to deny repeated bad-password attempts. Only failed
// attempts need to be kept; successful logins clear the window via the helper.
enum LoginKind {
  OPERATOR
  ADMIN
  CUSTOMER
}

model LoginAttempt {
  id        String    @id @default(cuid())
  kind      LoginKind
  emailKey  String
  createdAt DateTime  @default(now())

  @@index([kind, emailKey, createdAt])
}

// Gilijet — boat ticketing platform
// See REQUIREMENTS.md §5 for design notes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through Supabase's pgBouncer pooler (port 6543).
  // Required on serverless platforms (Vercel) — without it you exhaust
  // Postgres connections within minutes.
  url       = env("DATABASE_URL")
  // Migrations and `prisma db push` need a direct, non-pooled connection
  // (port 5432). Only needed when running prisma CLI; runtime ignores it.
  directUrl = env("DIRECT_URL")
}

// ============== ENUMS ==============

enum PaymentMethod {
  BANK_TRANSFER
  VA_BCA
  VA_BNI
  VA_BRI
  VA_MANDIRI
  VA_PERMATA
  GOPAY
  OVO
  DANA
  SHOPEEPAY
  LINKAJA
  QRIS
  CREDIT_CARD
}

enum PaymentProvider {
  XENDIT
  MAYAR
  MIDTRANS
}

enum RefundReason {
  CUSTOMER_REQUEST
  OPERATOR_CANCELLATION
  WEATHER
  ADMIN_OVERRIDE
}

enum AuditEntityType {
  BOOKING
  PAYMENT
  REFUND
  LEG
  SCHEDULE
  BOAT
  OPERATOR
  CUSTOMER
  TICKET
  PROMOTION
  RESCHEDULE_REQUEST
}

enum AuditUserRole {
  CUSTOMER
  OPERATOR
  ADMIN
  SYSTEM
}

// ============== USERS ==============

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  nationality  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings  Booking[]
  reviews   Review[]
  travelers Traveler[]

  @@index([email])
}

model Operator {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  companyName       String
  contactPerson     String
  phoneNumber       String
  bankAccountInfo   Json // { bankName, accountNumber, accountHolder }
  npwp              String? // Indonesian tax ID
  status            OperatorStatus @default(PENDING)
  documentsVerified Boolean        @default(false)
  commissionRate    Decimal        @default(0.08) @db.Decimal(5, 4)
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  boats    Boat[]
  legs     Leg[]
  bookings Booking[]

  @@index([status])
}

enum OperatorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
}

// ============== BOATS & SCHEDULES ==============

model Boat {
  id                  String     @id @default(cuid())
  operatorId          String
  name                String
  registrationNumber  String     @unique
  capacity            Int
  photos              String[] // URLs
  description         String?
  status              BoatStatus @default(ACTIVE)
  layoutConfiguration Json?     // { rows: [{ id, label, seats: [{ id, label, type }] }] }
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  operator  Operator   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  schedules Schedule[]

  @@index([operatorId])
}

enum BoatStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Schedule {
  id              String         @id @default(cuid())
  boatId          String
  originPort      String
  destinationPort String
  departureTime   String // "HH:MM" local time (Asia/Makassar by default)
  durationMinutes Int
  basePrice       Decimal        @db.Decimal(12, 2) // IDR
  daysOfWeek      Int[] // 1=Mon ... 7=Sun
  status          ScheduleStatus @default(ACTIVE)
  pricingTiers    Json?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  boat    Boat     @relation(fields: [boatId], references: [id], onDelete: Restrict)
  legs    Leg[]
  reviews Review[]

  @@index([boatId, status])
  @@index([originPort, destinationPort])
}

enum ScheduleStatus {
  ACTIVE
  INACTIVE
}

// ============== LEGS (specific departures) ==============

model Leg {
  id                 String    @id @default(cuid())
  scheduleId         String
  operatorId         String
  departureDate      DateTime // UTC instant of this specific departure
  totalCapacity      Int
  availableSeats     Int
  basePrice          Decimal   @db.Decimal(12, 2)
  status             LegStatus @default(OPEN)
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  schedule              Schedule            @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  operator              Operator            @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  bookings              Booking[]
  reschedulesAsOriginal RescheduleRequest[] @relation("OriginalLeg")
  reschedulesAsRequested RescheduleRequest[] @relation("RequestedLeg")
  seatLocks             SeatLock[]

  @@unique([scheduleId, departureDate])
  @@index([departureDate, status])
  @@index([operatorId, departureDate])
}

enum LegStatus {
  OPEN
  FULL
  SAILED
  CANCELLED
}

// ============== BOOKINGS & TICKETS ==============

model Booking {
  id                  String        @id @default(cuid())
  bookingReference    String        @unique // human-readable: BK-2026-05-000001
  legId               String
  customerId          String?
  operatorId          String
  customerName        String
  customerEmail       String
  customerPhone       String
  customerNationality String?
  totalAmount         Decimal       @db.Decimal(12, 2)
  commissionAmount    Decimal       @db.Decimal(12, 2)
  operatorAmount      Decimal       @db.Decimal(12, 2)
  currency            String        @default("IDR")
  status              BookingStatus @default(PENDING_PAYMENT)
  refundDeadline      DateTime
  refundPolicySnapshot Json?
  paymentGatewayRef   String?
  idempotencyKey      String?       @unique
  notes               String?
  promotionId         String?
  discountAmount      Decimal       @default(0) @db.Decimal(12, 2)
  reminderSentAt      DateTime?
  insuranceAmount     Decimal       @default(0) @db.Decimal(12, 2)
  pickupZone          String?
  pickupFee           Decimal       @default(0) @db.Decimal(12, 2)
  whatsappNumber      String?
  whatsappOptIn       Boolean       @default(false)
  agentId             String?
  agentCommissionAmount Decimal     @default(0) @db.Decimal(12, 2)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  leg               Leg                @relation(fields: [legId], references: [id])
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  operator          Operator           @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  promotion         Promotion?         @relation(fields: [promotionId], references: [id])
  agent             Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)
  tickets           Ticket[]
  payment           Payment?
  refund            Refund?
  review            Review?
  rescheduleRequest RescheduleRequest?

  @@index([legId])
  @@index([status])
  @@index([customerEmail])
  @@index([customerId])
  @@index([promotionId])
  @@index([agentId])
  @@index([operatorId, status])
  @@index([operatorId, createdAt])
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_OPERATOR
  EXPIRED
}

model Ticket {
  id                String       @id @default(cuid())
  ticketCode        String       @unique // TK-2026-05-000001-1
  bookingId         String
  passengerName     String
  passengerIdNumber String?
  qrHash            String       @unique
  seatId            String?
  status            TicketStatus @default(ISSUED)
  checkedInAt       DateTime?
  checkedInBy       String?
  createdAt         DateTime     @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([qrHash])
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  NO_SHOW
  REFUNDED
}

// ============== PAYMENTS & REFUNDS ==============

model Payment {
  id               String         @id @default(cuid())
  bookingId        String         @unique
  amount           Decimal        @db.Decimal(12, 2)
  method           PaymentMethod
  status           PaymentStatus  @default(PENDING)
  gatewayProvider  PaymentProvider @default(XENDIT)
  gatewayReference String?
  gatewayFee       Decimal        @default(0) @db.Decimal(12, 2)
  paidAt           DateTime?
  failedReason     String?
  rawWebhookData   Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([gatewayReference])
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  EXPIRED
}

model Refund {
  id               String       @id @default(cuid())
  bookingId        String       @unique
  originalAmount   Decimal      @db.Decimal(12, 2)
  refundAmount     Decimal      @db.Decimal(12, 2)
  reason           RefundReason
  status           RefundStatus @default(PENDING)
  gatewayReference String?
  processedAt      DateTime?
  approvedBy       String? // Admin.id who approved/rejected
  approvedAt       DateTime?
  adminNote        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status])
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

// ============== WEBHOOK EVENTS (retry queue) ==============

model WebhookEvent {
  id            String             @id @default(cuid())
  provider      String             // 'xendit' | 'midtrans'
  eventType     String             // 'invoice.paid' | 'invoice.expired' | etc.
  externalRef   String             // bookingReference or refund gateway id
  rawPayload    Json
  status        WebhookEventStatus @default(PENDING)
  attempts      Int                @default(0)
  lastAttemptAt DateTime?
  processedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([provider, externalRef])
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED
}

// ============== PROMOTIONS ==============

model Promotion {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  minAmount     Decimal      @default(0) @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  description   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  bookings Booking[]

  @@index([code, isActive])
}

enum DiscountType {
  PERCENT
  FLAT
}

// ============== REVIEWS ==============

model Review {
  id         String   @id @default(cuid())
  customerId String
  bookingId  String   @unique
  scheduleId String
  rating     Int
  text       String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([customerId])
}

// ============== RESCHEDULE REQUESTS ==============

model RescheduleRequest {
  id             String           @id @default(cuid())
  bookingId      String           @unique
  originalLegId  String
  requestedLegId String
  status         RescheduleStatus @default(PENDING)
  customerNote   String?
  adminNote      String?
  processedBy    String?
  processedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  originalLeg  Leg     @relation("OriginalLeg", fields: [originalLegId], references: [id])
  requestedLeg Leg     @relation("RequestedLeg", fields: [requestedLegId], references: [id])

  @@index([status])
}

enum RescheduleStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ============== PASSWORD RESET ==============

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// ============== AUDIT LOG ==============

model AuditLog {
  id            String          @id @default(cuid())
  entityType    AuditEntityType
  entityId      String
  action        String
  userId        String?
  userRole      AuditUserRole?
  previousState Json?
  newState      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============== TRAVELERS (saved passengers) ==============

model Traveler {
  id          String        @id @default(cuid())
  customerId  String
  fullName    String
  idNumber    String?
  type        PassengerType @default(ADULT)
  phoneNumber String?
  nationality String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

// ============== SEAT LOCKS ==============

model SeatLock {
  id               String   @id @default(cuid())
  legId            String
  seatId           String
  bookingSessionId String
  lockedAt         DateTime @default(now())
  expiresAt        DateTime

  leg Leg @relation(fields: [legId], references: [id], onDelete: Cascade)

  @@unique([legId, seatId])
  @@index([expiresAt])
}

// ============== SEA CONDITIONS ==============

model SeaCondition {
  id        String    @id @default(cuid())
  routeKey  String    @unique // "Sanur-Nusa Penida"
  status    SeaStatus @default(NORMAL)
  message   String?
  updatedAt DateTime  @default(now())
  updatedBy String?

  @@index([routeKey])
}

enum SeaStatus {
  NORMAL
  ROUGH
  DANGEROUS
}

// ============== AGENTS (B2B affiliates) ==============

model Agent {
  id              String      @id @default(cuid())
  companyName     String
  contactPerson   String
  email           String      @unique
  passwordHash    String
  apiKeyHash      String      @unique
  commissionRate  Decimal     @default(0.03) @db.Decimal(5, 4)
  status          AgentStatus @default(PENDING)
  bankAccountInfo Json
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  bookings Booking[]

  @@index([status])
}

enum AgentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

// Gilifast — boat ticketing platform
// See REQUIREMENTS.md §5 for design notes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through Supabase's pgBouncer pooler (port 6543).
  // Required on serverless platforms (Vercel) — without it you exhaust
  // Postgres connections within minutes.
  url       = env("DATABASE_URL")
  // Migrations and `prisma db push` need a direct, non-pooled connection
  // (port 5432). Only needed when running prisma CLI; runtime ignores it.
  directUrl = env("DIRECT_URL")
}

// ============== ENUMS ==============

enum PaymentMethod {
  BANK_TRANSFER
  VA_BCA
  VA_BNI
  VA_BRI
  VA_MANDIRI
  VA_PERMATA
  GOPAY
  OVO
  DANA
  SHOPEEPAY
  LINKAJA
  QRIS
  CREDIT_CARD
  PAYPAL
}

enum PaymentProvider {
  MIDTRANS
  PAYPAL
  // Legacy values retained (unused by the app) so `prisma db push` without
  // --accept-data-loss stays additive: dropping enum values that existing rows
  // still reference is destructive and would fail the whole push, leaving the
  // DB without the columns/values it needs.
  XENDIT
  MAYAR
  STRIPE
  DOKU
}

enum RefundReason {
  CUSTOMER_REQUEST
  OPERATOR_CANCELLATION
  WEATHER
  ADMIN_OVERRIDE
}

enum AuditEntityType {
  BOOKING
  PAYMENT
  REFUND
  LEG
  SCHEDULE
  BOAT
  OPERATOR
  CUSTOMER
  TICKET
  PROMOTION
  RESCHEDULE_REQUEST
  PLATFORM_CONFIG
}

enum AuditUserRole {
  CUSTOMER
  OPERATOR
  ADMIN
  SYSTEM
}

// ============== USERS ==============

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  fullName     String
  phoneNumber  String?
  nationality  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings Booking[]
  reviews  Review[]
  loyaltyAccount LoyaltyAccount?

  @@index([email])
}

model Operator {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  companyName       String
  contactPerson     String
  phoneNumber       String
  bankAccountInfo   Json // { bankName, accountNumber, accountHolder }
  npwp              String? // Indonesian tax ID
  status            OperatorStatus @default(PENDING)
  documentsVerified Boolean        @default(false)
  commissionRate    Decimal        @default(0.08) @db.Decimal(5, 4)
  agentId           String?
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  boats    Boat[]
  legs     Leg[]
  bookings Booking[]
  services OperatorServicesOnOperator[]
  staff    OperatorStaff[]
  documents OperatorDocument[]
  travelAgents TravelAgent[]
  cashDrawerSessions CashDrawerSession[]
  notifications OperatorNotification[]
  agent    Agent? @relation(fields: [agentId], references: [id])

  @@index([status])
}

enum OperatorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
}

// ============== BOATS & SCHEDULES ==============

model Boat {
  id                 String     @id @default(cuid())
  operatorId         String
  name               String
  registrationNumber String     @unique
  capacity           Int
  category           String     @default("Public")
  photos             String[] // URLs
  description        String?
  status             BoatStatus @default(ACTIVE)
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  operator  Operator   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  schedules Schedule[]
  facilities BoatFacilitiesOnBoat[]
  positions  BoatPosition[]

  @@index([operatorId])
}

enum BoatStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Schedule {
  id              String         @id @default(cuid())
  boatId          String
  originPort      String
  destinationPort String
  originPortId    String?
  destinationPortId String?
  departureTime   String // "HH:MM" local time (Asia/Makassar by default)
  durationMinutes Int
  basePrice       Decimal        @db.Decimal(12, 2) // IDR
  daysOfWeek      Int[] // 1=Mon ... 7=Sun
  status          ScheduleStatus @default(ACTIVE)
  pricingTiers    Json?
  // Full operator price sheet: season x passenger category x one-way/return.
  // basePrice holds the adult/low/one-way cell; this keeps the rest. See lib/fares.ts.
  fareMatrix      Json?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  boat    Boat     @relation(fields: [boatId], references: [id], onDelete: Restrict)
  legs    Leg[]
  reviews Review[]
  transitStops TransitStop[]
  originPortRel Port? @relation("OriginPort", fields: [originPortId], references: [id])
  destinationPortRel Port? @relation("DestinationPort", fields: [destinationPortId], references: [id])

  @@index([boatId, status])
  @@index([originPort, destinationPort])
}

enum ScheduleStatus {
  ACTIVE
  INACTIVE
}

// ============== LEGS (specific departures) ==============

model Leg {
  id                 String    @id @default(cuid())
  scheduleId         String
  operatorId         String
  departureDate      DateTime // UTC instant of this specific departure
  totalCapacity      Int
  availableSeats     Int
  basePrice          Decimal   @db.Decimal(12, 2)
  status             LegStatus @default(OPEN)
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  schedule               Schedule            @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  operator               Operator            @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  bookings               Booking[]
  reschedulesAsOriginal  RescheduleRequest[] @relation("OriginalLeg")
  reschedulesAsRequested RescheduleRequest[] @relation("RequestedLeg")
  seatHolds              SeatHold[]
  weatherSnapshots       WeatherSnapshot[]

  @@unique([scheduleId, departureDate])
  @@index([departureDate, status])
  @@index([operatorId, departureDate])
}

enum LegStatus {
  OPEN
  FULL
  SAILED
  CANCELLED
}

// ============== BOOKINGS & TICKETS ==============

model Booking {
  id                   String        @id @default(cuid())
  bookingReference     String        @unique
  legId                String
  customerId           String?
  operatorId           String
  agentId              String?
  salesChannel         SalesChannel  @default(GILIFAST)
  salesStaffId         String?
  salesAgentId         String?
  agentCommissionAmount  Decimal?    @db.Decimal(14, 2)
  agentCommissionPercent Decimal?    @db.Decimal(5, 4)
  pph23WithholdingAmount Decimal?     @db.Decimal(14, 2)
  cashCollected        Decimal?      @db.Decimal(14, 2)
  externalAggregatorName String?
  externalAggregatorRef  String?
  eFakturNumber        String?
  eFakturStatus        EFakturStatus @default(NOT_REQUIRED)
  customerName         String
  customerEmail        String
  customerPhone        String
  customerNationality  String?
  totalAmount          Decimal       @db.Decimal(12, 2)
  commissionAmount     Decimal       @db.Decimal(12, 2)
  operatorAmount       Decimal       @db.Decimal(12, 2)
  currency             String        @default("IDR")
  status               BookingStatus @default(PENDING_PAYMENT)
  refundDeadline       DateTime
  refundPolicySnapshot Json?
  paymentGatewayRef    String?
  idempotencyKey       String?       @unique
  notes                String?
  promotionId          String?
  discountAmount       Decimal       @default(0) @db.Decimal(12, 2)
  reminderSentAt       DateTime?
  // Manual availability check: who rang the operator, when, and what they were
  // told. availabilityDecidedAt is set on both approve and reject; the booking
  // status says which way it went.
  availabilityDecidedAt   DateTime?
  availabilityDecidedById String?
  availabilityNote        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  leg               Leg                @relation(fields: [legId], references: [id], onDelete: Restrict)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  operator          Operator           @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  agent             Agent?             @relation(fields: [agentId], references: [id])
  salesStaff        OperatorStaff?     @relation("SalesStaff", fields: [salesStaffId], references: [id])
  salesAgent        TravelAgent?       @relation(fields: [salesAgentId], references: [id])
  promotion         Promotion?         @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  promotionRedemption PromotionRedemption?
  tickets           Ticket[]
  payment           Payment?
  refund            Refund?
  review            Review?
  rescheduleRequest RescheduleRequest?
  addons            BookingAddon[]
  seatHold          SeatHold?
  loyaltyTransactions LoyaltyTransaction[]

  @@index([legId])
  @@index([status])
  @@index([customerEmail])
  @@index([customerId])
  @@index([promotionId])
  @@index([operatorId, status])
  @@index([operatorId, createdAt])
  @@index([operatorId, salesChannel, createdAt])
  @@index([salesAgentId])
}

enum BookingStatus {
  PENDING_PAYMENT
  // Paid, but the seat is not promised yet. Operators here work by phone
  // rather than through the dashboard, so an admin rings them to check the
  // boat is actually running before any boarding pass goes out. Seats stay
  // held on the Leg for the whole of this window.
  AWAITING_CONFIRMATION
  CONFIRMED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_OPERATOR
  EXPIRED
}

model Ticket {
  id                String       @id @default(cuid())
  ticketCode        String       @unique // TK-2026-05-000001-1
  bookingId         String
  passengerName     String
  passengerIdNumber String?
  qrHash            String       @unique
  status            TicketStatus @default(ISSUED)
  checkedInAt       DateTime?
  checkedInById     String?
  checkedInBy       String?
  createdAt         DateTime     @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  checkedInByStaff OperatorStaff? @relation("CheckedInBy", fields: [checkedInById], references: [id])

  @@index([bookingId])
  @@index([qrHash])
  @@index([checkedInById])
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  NO_SHOW
  REFUNDED
}

// ============== PAYMENTS & REFUNDS ==============

model Payment {
  id               String          @id @default(cuid())
  bookingId        String          @unique
  amount           Decimal         @db.Decimal(12, 2)
  method           PaymentMethod
  status           PaymentStatus   @default(PENDING)
  gatewayProvider  PaymentProvider @default(MIDTRANS)
  gatewayReference String?
  gatewayFee       Decimal         @default(0) @db.Decimal(12, 2)
  paidAt           DateTime?
  failedReason     String?
  rawWebhookData   Json?
  // Midtrans Snap: the snap token stored as gateway reference so the pay
  // page can use it to re-open the payment popup.
  instrumentData   Json?
  expiresAt        DateTime?

  // Cross-currency capture. `amount` above stays the authoritative IDR total;
  // these record what the customer was actually charged abroad. PayPal cannot
  // settle IDR, so a PayPal payment always charges a presentment currency and
  // a refund must return the presentment amount captured — re-converting at a
  // later rate would silently over- or under-refund.
  presentmentCurrency String?   @db.VarChar(3)
  presentmentAmount   Decimal?  @db.Decimal(12, 2)
  fxRate              Decimal?  @db.Decimal(18, 6) // IDR per 1 presentment unit
  fxQuotedAt          DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([gatewayReference])
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  EXPIRED
}

model Refund {
  id               String       @id @default(cuid())
  bookingId        String       @unique
  originalAmount   Decimal      @db.Decimal(12, 2)
  refundAmount     Decimal      @db.Decimal(12, 2)
  reason           RefundReason
  status           RefundStatus @default(PENDING)
  gatewayReference String?
  processedAt      DateTime?
  approvedBy       String? // Admin.id who approved/rejected
  approvedAt       DateTime?
  adminNote        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status])
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

// ============== WEBHOOK EVENTS (retry queue) ==============

model WebhookEvent {
  id            String             @id @default(cuid())
  provider      String // 'xendit' | 'midtrans'
  eventType     String // 'invoice.paid' | 'invoice.expired' | etc.
  externalRef   String // bookingReference or refund gateway id
  rawPayload    Json
  status        WebhookEventStatus @default(PENDING)
  attempts      Int                @default(0)
  lastAttemptAt DateTime?
  processedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([provider, externalRef])
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED
}

// ============== PROMOTIONS ==============

model Promotion {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  minAmount     Decimal      @default(0) @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  archivedAt    DateTime?
  description   String?

  // Owner-console targeting & controls
  perCustomerLimit     Int?
  firstBookingOnly     Boolean         @default(false)
  maxDiscountAmount    Decimal?        @db.Decimal(12, 2)
  stackable            Boolean         @default(false)
  costBearer           PromoCostBearer @default(SHARED)
  appliesToRouteCodes  String[]        @default([])
  appliesToOperatorIds String[]        @default([])
  budgetCap            Decimal?        @db.Decimal(12, 2)
  budgetSpent          Decimal         @default(0) @db.Decimal(12, 2)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  bookings    Booking[]
  redemptions PromotionRedemption[]

  @@index([code, isActive])
}

enum PromoCostBearer {
  PLATFORM
  OPERATOR
  SHARED
}

/// One row per successful coupon use. Enables per-customer limits and
/// spend analytics that a single usedCount counter cannot express.
model PromotionRedemption {
  id            String   @id @default(cuid())
  promotionId   String
  bookingId     String   @unique
  customerEmail String
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([promotionId])
  @@index([customerEmail])
}

/// Singleton platform-economics config (id is always "default"). Holds the
/// values the owner console tunes: platform-default commission, optional
/// service fee, traveler multipliers, and the default yield-tier template.
model PlatformConfig {
  id                String   @id @default("default")
  commissionRate    Decimal  @default(0.08) @db.Decimal(5, 4)
  // Runtime gateway mode overrides. ENV follows the DOKU_IS_PRODUCTION /
  // PAYPAL_IS_PRODUCTION env flags; SANDBOX / LIVE force the host without a
  // redeploy. See lib/payment-mode.ts.
  dokuMode          GatewayMode @default(ENV)
  paypalMode        GatewayMode @default(ENV)
  serviceFeeType    DiscountType?
  serviceFeeValue   Decimal  @default(0) @db.Decimal(12, 2)
  adultMultiplier   Decimal  @default(1) @db.Decimal(5, 4)
  childMultiplier   Decimal  @default(0.5) @db.Decimal(5, 4)
  infantMultiplier  Decimal  @default(0) @db.Decimal(5, 4)
  defaultPricingTiers Json?
  // Where booking alerts go, and the WATI template that carries them. Kept on
  // the config row rather than only in env so the on-call number can move
  // between staff without a redeploy. Env supplies the fallback; see
  // lib/admin-alerts.ts.
  adminWhatsappNumber String?
  adminAlertTemplate  String?
  alertOnNewBooking   Boolean  @default(true)
  alertOnBookingPaid  Boolean  @default(true)
  updatedBy         String?
  updatedAt         DateTime @updatedAt @default(now())
}

enum DiscountType {
  PERCENT
  FLAT
}

/// How a payment gateway's live/sandbox host is chosen at runtime. ENV follows
/// the DOKU_IS_PRODUCTION / PAYPAL_IS_PRODUCTION flags; the other two force it.
enum GatewayMode {
  ENV
  SANDBOX
  LIVE
}

// ============== REVIEWS ==============

model Review {
  id         String   @id @default(cuid())
  customerId String
  bookingId  String   @unique
  scheduleId String
  rating     Int
  text       String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([scheduleId])
  @@index([customerId])
}

// ============== RESCHEDULE REQUESTS ==============

model RescheduleRequest {
  id             String           @id @default(cuid())
  bookingId      String           @unique
  originalLegId  String
  requestedLegId String
  status         RescheduleStatus @default(PENDING)
  customerNote   String?
  adminNote      String?
  processedBy    String?
  processedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  originalLeg  Leg     @relation("OriginalLeg", fields: [originalLegId], references: [id])
  requestedLeg Leg     @relation("RequestedLeg", fields: [requestedLegId], references: [id])

  @@index([status])
}

enum RescheduleStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

